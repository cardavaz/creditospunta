generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum LoanStatus {
  PENDING
  ACTIVE
  PAID_OFF
  DEFAULTED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum Role {
  ADMIN
  OPERADOR
  RIESGO
  COBRANZA
  CONSULTA
}

enum AuditResult {
  OK
  DENIED
  ERROR
}

enum CollectionChannel {
  CALL
  WHATSAPP
  EMAIL
  VISIT
  OTHER
}

enum CollectionResult {
  NO_CONTACT
  PROMISE_TO_PAY
  REFUSED
  PAID
  OTHER
}

model Product {
  id            String   @id @default(cuid())
  name          String   @unique
  minAmount     Decimal  @db.Decimal(14,2)
  maxAmount     Decimal  @db.Decimal(14,2)
  allowedTerms  Int[]
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  applications  LoanApplication[]
}

model Client {
  id              String @id @default(cuid())
  documentNumber  String @unique
  firstName       String
  lastName        String
  phone           String?
  email           String?
  address         String?
  monthlyIncome   Decimal? @db.Decimal(14,2)
  employmentYears Decimal? @db.Decimal(5,2)
  status          ClientStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  applications    LoanApplication[]
  loans           Loan[]
  @@index([lastName, firstName])
  @@index([status])
}

model LoanApplication {
  id              String @id @default(cuid())
  clientId        String
  productId       String?
  requestedAmount Decimal @db.Decimal(14,2)
  termMonths      Int
  annualRate      Decimal @db.Decimal(8,4)
  monthlyPayment  Decimal @db.Decimal(14,2)
  scorePunta      Int?
  riskLevel       String?
  scoreReasons    String[] @default([])
  status          ApplicationStatus @default(DRAFT)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  client          Client @relation(fields: [clientId], references: [id])
  product         Product? @relation(fields: [productId], references: [id])
  loan            Loan?
  @@index([clientId, status])
}

model Loan {
  id              String @id @default(cuid())
  clientId        String
  applicationId   String? @unique
  principal       Decimal @db.Decimal(14,2)
  annualRate      Decimal @db.Decimal(8,4)
  termMonths      Int
  monthlyPayment  Decimal @db.Decimal(14,2)
  totalAmount     Decimal @db.Decimal(14,2)
  interestAmount  Decimal @db.Decimal(14,2)
  startDate       DateTime
  status          LoanStatus @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  client          Client @relation(fields: [clientId], references: [id])
  application     LoanApplication? @relation(fields: [applicationId], references: [id])
  installments    Installment[]
  collectionActions CollectionAction[]
  @@index([clientId, status])
}

model Installment {
  id          String @id @default(cuid())
  loanId      String
  number      Int
  dueDate     DateTime
  amount      Decimal @db.Decimal(14,2)
  paidAmount  Decimal @default(0) @db.Decimal(14,2)
  status      InstallmentStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  loan        Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  payments    Payment[]
  @@unique([loanId, number])
  @@index([dueDate, status])
}

model CollectionAction {
  id           String             @id @default(cuid())
  loanId       String
  installmentId String?
  actorId      String?
  channel      CollectionChannel
  result       CollectionResult
  promiseDate  DateTime?
  notes        String?
  createdAt    DateTime           @default(now())
  loan         Loan               @relation(fields: [loanId], references: [id])
  actor        User?              @relation(fields: [actorId], references: [id])
  @@index([loanId, createdAt])
}

model Payment {
  id            String @id @default(cuid())
  installmentId String
  amount        Decimal @db.Decimal(14,2)
  method        PaymentMethod
  reference     String?
  paidAt        DateTime @default(now())
  notes         String?
  installment   Installment @relation(fields: [installmentId], references: [id])
  @@index([installmentId, paidAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  active       Boolean  @default(true)
  failedLoginAttempts Int @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditEvents  AuditEvent[]
  collectionActions CollectionAction[]
  @@index([role])
}

model AuditEvent {
  id         String      @id @default(cuid())
  actorId    String?
  action     String
  entity     String
  entityId   String
  result     AuditResult
  reason     String?
  occurredAt DateTime    @default(now())
  actor      User?       @relation(fields: [actorId], references: [id])
  @@index([entity, entityId])
  @@index([occurredAt])
}
