generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientStatus { ACTIVE INACTIVE BLOCKED }
enum ApplicationStatus { DRAFT SUBMITTED UNDER_REVIEW APPROVED REJECTED CANCELLED }
enum LoanStatus { PENDING ACTIVE PAID_OFF DEFAULTED CANCELLED }
enum InstallmentStatus { PENDING PARTIAL PAID OVERDUE }
enum PaymentMethod { CASH BANK_TRANSFER CARD OTHER }

model Client {
  id              String @id @default(cuid())
  documentNumber  String @unique
  firstName       String
  lastName        String
  phone           String?
  email           String?
  address         String?
  monthlyIncome   Decimal? @db.Decimal(14,2)
  employmentYears Decimal? @db.Decimal(5,2)
  status          ClientStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  applications    LoanApplication[]
  loans           Loan[]
  @@index([lastName, firstName])
  @@index([status])
}

model LoanApplication {
  id              String @id @default(cuid())
  clientId        String
  requestedAmount Decimal @db.Decimal(14,2)
  termMonths      Int
  annualRate      Decimal @db.Decimal(8,4)
  monthlyPayment  Decimal @db.Decimal(14,2)
  scorePunta      Int?
  riskLevel       String?
  status          ApplicationStatus @default(DRAFT)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  client          Client @relation(fields: [clientId], references: [id])
  loan            Loan?
  @@index([clientId, status])
}

model Loan {
  id              String @id @default(cuid())
  clientId        String
  applicationId   String? @unique
  principal       Decimal @db.Decimal(14,2)
  annualRate      Decimal @db.Decimal(8,4)
  termMonths      Int
  monthlyPayment  Decimal @db.Decimal(14,2)
  totalAmount     Decimal @db.Decimal(14,2)
  interestAmount  Decimal @db.Decimal(14,2)
  startDate       DateTime
  status          LoanStatus @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  client          Client @relation(fields: [clientId], references: [id])
  application     LoanApplication? @relation(fields: [applicationId], references: [id])
  installments    Installment[]
  @@index([clientId, status])
}

model Installment {
  id          String @id @default(cuid())
  loanId      String
  number      Int
  dueDate     DateTime
  amount      Decimal @db.Decimal(14,2)
  paidAmount  Decimal @default(0) @db.Decimal(14,2)
  status      InstallmentStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  loan        Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  payments    Payment[]
  @@unique([loanId, number])
  @@index([dueDate, status])
}

model Payment {
  id            String @id @default(cuid())
  installmentId String
  amount        Decimal @db.Decimal(14,2)
  method        PaymentMethod
  reference     String?
  paidAt        DateTime @default(now())
  notes         String?
  installment   Installment @relation(fields: [installmentId], references: [id])
  @@index([installmentId, paidAt])
}
